@startuml General_Framework_Diagram
' ============================================================
' GENERAL FRAMEWORK DIAGRAM - Scene Graph Generation with RL
' ============================================================
' Author: Auto-generated from original PNG
' Description: VRD + Reinforcement Learning + Image Generation
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowThickness 2
skinparam RoundCorner 15

' Color definitions
!define VRD_YELLOW #FFF3CD
!define VRD_GREEN #D4EDDA
!define VRD_CYAN #D1ECF1
!define VRD_GRAY #E2E3E5

!define RL_PURPLE #E8DAEF
!define RL_YELLOW #FCF3CF
!define RL_GREEN #D5F5E3
!define RL_RED #FADBD8
!define RL_ORANGE #FDEBD0

!define GEN_PINK #F8D7DA
!define GEN_BROWN #D4A5A5
!define GEN_BLUE #AED6F1
!define GEN_MINT #A9DFBF
!define GEN_GRAY #D5DBDB

' ==================== VRD FRAMEWORK ====================
rectangle "**VRD Framework**" as VRD_BOX #FAFAFA {
    
    rectangle "🖼️\n**Input Image**" as InputImage #FFFFFF
    
    rectangle "🔍\n**Object\nDetector**\n<size:9>//YOLO, Faster-RCNN,//\n//DETR//</size>" as ObjectDetector VRD_YELLOW
    
    rectangle "📦\n**Object\nClassifier**\n<size:9>//CLIP, ResNet,//\n//ViT//</size>" as ObjectClassifier VRD_GREEN
    
    rectangle "🔗\n**Relation\nDetector**\n<size:9>//RelTR, Motifs,//\n//VCTree//</size>" as RelationDetector VRD_CYAN
    
    rectangle "🕸️\n**Scene Graph**\n<size:9>//Objects,//\n//Relationships,//\n//Triplets//</size>" as SceneGraph VRD_GRAY
    
    InputImage -right-> ObjectDetector
    ObjectDetector -right-> ObjectClassifier
    ObjectClassifier -right-> RelationDetector
    RelationDetector -right-> SceneGraph
}

' ==================== REINFORCEMENT LEARNING ====================
rectangle "**Reinforcement Learning**" as RL_BOX #F5F5F5 {
    
    rectangle "📊\n**State\nEncoder**\n<size:9>//Performance//\n//Metrics//</size>" as StateEncoder RL_PURPLE
    
    rectangle "**RL Agent**" as RLAgentBox #FFFFFF {
        rectangle "💡\n**Policy\nNetwork**\n<size:9>//DQN, PPO, A3C//</size>" as PolicyNetwork RL_YELLOW
    }
    
    rectangle "⚙️\n**Action\nDecoder**\n<size:9>//Generation//\n//Parameters//</size>" as ActionDecoder RL_GREEN
    
    rectangle "📈\n**Evaluation**" as Evaluation RL_RED
    
    rectangle "🏆\n**Reward\nCalculator**" as RewardCalculator RL_ORANGE
    
    StateEncoder -right-> PolicyNetwork
    PolicyNetwork -right-> ActionDecoder
    ActionDecoder -right-> Evaluation
    Evaluation -down-> RewardCalculator
    RewardCalculator -left-> PolicyNetwork : "Reward Signal"
}

' ==================== IMAGE GENERATION WITH AI ====================
rectangle "**Image Generation with AI**" as GEN_BOX #F0F0F0 {
    
    rectangle "📝\n**Prompt\nGenerator**\n<size:9>//Text Prompts//</size>" as PromptGenerator GEN_PINK
    
    rectangle "🎨\n**Generative\nModel**\n<size:9>//Stable Diffusion,//\n//DALL-E//</size>" as GenerativeModel GEN_BROWN
    
    rectangle "🔽\n**Quality\nFilter**\n<size:9>//Image Quality//\n//Assessment//</size>" as QualityFilter GEN_BLUE
    
    rectangle "🏷️\n**Auto-\nAnnotator**\n<size:9>//GroundingDINO,//\n//OWL-ViT//</size>" as AutoAnnotator GEN_MINT
    
    rectangle "📁\n**Synthetic\nDataset**\n<size:9>//Annotated//\n//Images//</size>" as SyntheticDataset GEN_GRAY
    
    PromptGenerator -right-> GenerativeModel
    GenerativeModel -right-> QualityFilter
    QualityFilter -right-> AutoAnnotator
    AutoAnnotator -right-> SyntheticDataset
}

' ==================== CROSS-CONNECTIONS ====================
' VRD to RL
SceneGraph -down-> StateEncoder

' RL to Generation
ActionDecoder -down-> PromptGenerator

' Data Augmentation Loop (Generation back to VRD)
SyntheticDataset -up-> InputImage : "**Data Augmentation**"

@enduml
